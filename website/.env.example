# Copy this file to .env.local and fill in the values.
# If a value is left empty the app runs in DEMO MODE for that part:
#   - no GEMINI_API_KEY  -> photo analysis returns a sample result
#   - no MONGODB_URI     -> reports are kept in memory (lost on restart)

# ── AI (photo analysis) ─────────────────────────────────────────────
# Set at least one key. With both, the site falls back automatically:
# Gemini Flash-Lite → Groq → Gemini Flash.
# Google Gemini — https://aistudio.google.com/app/apikey (no card needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Groq — https://console.groq.com/keys (free, no card needed)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Which to try first: gemini (default) or groq
AI_PROVIDER=gemini
# Max seconds per attempt, in milliseconds
AI_TIMEOUT_MS=12000

# MongoDB Atlas — same database the Android app uses
MONGODB_URI=
MONGODB_DB=FixMyStreet

# Google Maps — https://console.cloud.google.com/google/maps-apis
# Leave both keys empty to use the free OpenFreeMap / OpenStreetMap map instead.
# Browser key: shows the map. Restrict it to your website addresses.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID (Google Cloud → Map Management). DEMO_MAP_ID if empty.
GOOGLE_MAPS_MAP_ID=
# Server key: turns GPS coordinates into street addresses (Geocoding API).
GOOGLE_MAPS_SERVER_KEY=

# Email for sign-up and password-reset codes (Gmail).
# GMAIL_APP_PASSWORD is a Google "App Password", NOT the normal Gmail password:
#   1. Turn on 2-Step Verification for the Gmail account
#   2. Go to https://myaccount.google.com/apppasswords → create one named "Tareeq"
#   3. Paste the 16 letters here (spaces are fine)
# Leave empty to test without email: the code is shown on screen instead.
GMAIL_USER=tareeq.hackathon@gmail.com
GMAIL_APP_PASSWORD=

# Any long random string; signs the login cookie

SESSION_SECRET=change-me-to-a-long-random-string
